{
  "manifest_version": 3,
  "name": "MiniMuse Companion",
  "version": "1.2.12",
  "description": "Use MiniMuse in Chrome Side Panel and share a background tab safely via chrome.debugger without other extensions breaking it or stealing focus.",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open MiniMuse Side Panel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
